  "quick_start": {
    "backend": [
      "cd backend",
      "python -m venv .venv",
      "source .venv/bin/activate",
      "pip install -r requirements.txt",
      "export DATABASE_URL=sqlite:///./ai_talent_finder.db",
      "python -m uvicorn app.main:app --host 127.0.0.1 --port 8000"
    ],
    "frontend": [
      "cd frontend",
      "npm install",
      "npm run dev"
    ],
    "tests": [
      "cd backend",
      "python -m pytest tests/test_data_scoring_services.py -v"
    ],
    "visit_url": "http://localhost:3000/scoring"
